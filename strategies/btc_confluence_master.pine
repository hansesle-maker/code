//@version=6
// ============================================================================
// BTC Confluence Master  —  6-Strategy MTF Synthesis
// ----------------------------------------------------------------------------
// Combines six proven BTC strategies, but respects the timeframe each one
// actually works on. They are NOT forced onto a single chart timeframe:
//
//   HIGHER TIMEFRAME (default 4H)  ->  TREND BIAS  (which side to trade)
//     2. SuperTrend STRATEGY ......... ATR-band trend direction (10, 3.0)
//     3. Hull Suite Strategy ......... HMA-55 slope
//     4. Single EMA Cross ............ EMA 10/20 alignment
//     5. Twin Optimized Trend Tracker  VAR-based OTT band state
//     6. MACD ReLoaded ............... VAR (VIDYA) MACD histogram
//   These five vote on the 4H timeframe (via request.security, non-repainting)
//   to produce a 0..5 bull / bear bias score.
//
//   CHART TIMEFRAME (run on 1H)    ->  ENTRY TIMING + RISK
//     1. VWAP Trend Momentum ......... session VWAP regime, pullback entry,
//                                      ATR SL/TP, UT Bot trailing stop,
//                                      max-trades-per-day cap
//
// Logic: only when the 4H bias score agrees (>= HTF Bias Score) do we arm the
// 1H VWAP pullback entry. The 4H swing stack decides direction; the 1H VWAP
// engine decides the moment and manages the trade. This resolves the mismatch
// where VWAP is an intraday (1H) tool and the trend stack is tuned for 4H.
//
// Credit: SuperTrend / TOTT / MACD ReLoaded (c) KivancOzbilgic; Twin OTT by
// Anil Ozeksi; Hull Suite by InSilico; UT Bot trailing stop by HPotter.
//
// Not financial advice. Past performance does not guarantee future results.
// RECOMMENDED: apply this strategy on a 1H BTC chart, keep HTF = 240 (4H).
// ============================================================================
strategy("BTC Confluence Master [MTF 6-in-1]", overlay=true,
     initial_capital=50000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.05,
     slippage=2, calc_on_every_tick=false, pyramiding=0)

// ---------------------------------------------------------------- palette --
var color C_BULL=#00dcb4, var color C_BEAR=#ff4976, var color C_GOLD=#f0b90b
var color C_ICE=#4fc3f7,  var color C_SILVER=#8a919e, var color C_DIM=#5f6368
var color C_PANEL=#0e1726, var color C_BORDER=#1e3a5f, var color C_WHITE=#e8eaed
var color C_PURPLE=#b388ff, var color C_NEON=#76ff03,  var color C_RED=#ff1744
var color C_ORANGE=#ff9100, var color C_ELECTRIC=#448aff, var color C_CYAN=#18ffff

// ----------------------------------------------------------------- inputs --
grpMTF   = "Higher-Timeframe Bias (4H stack)"
grpEntry = "Entry (1H VWAP engine)"
grpRisk  = "Risk"
grpTrail = "Trailing Stop (UT Bot)"
grpFilt  = "Backtest Window"
grpVis   = "Visuals"

i_htf       = input.timeframe("240", "Higher Timeframe", group=grpMTF,
     tooltip="Timeframe the 5 swing-trend components vote on. Keep at 240 (4H) while the chart is on 1H.")
i_htfScore  = input.int(4, "HTF Bias Score (of 5)", minval=1, maxval=5, group=grpMTF,
     tooltip="Minimum number of the five 4H components that must agree before entries are armed.")
i_stLen     = input.int(10, "SuperTrend ATR Period", group=grpMTF)
i_stMult    = input.float(3.0, "SuperTrend Multiplier", step=0.1, group=grpMTF)
i_hullLen   = input.int(55, "Hull MA Length", group=grpMTF)
i_emaFast   = input.int(10, "Fast EMA", group=grpMTF)
i_emaSlow   = input.int(20, "Slow EMA", group=grpMTF)
i_tottLen   = input.int(40, "TOTT Period (VAR)", minval=1, group=grpMTF)
i_tottPct   = input.float(1.0, "TOTT Optimization %", step=0.1, minval=0, group=grpMTF)
i_tottCoeff = input.float(0.001, "TOTT Twin Coefficient", step=0.001, minval=0, group=grpMTF)
i_macdFast  = input.int(12, "MACD Fast (VAR)", minval=1, group=grpMTF)
i_macdSlow  = input.int(26, "MACD Slow (VAR)", minval=1, group=grpMTF)
i_macdTrig  = input.int(9, "MACD Trigger (VAR)", minval=1, group=grpMTF)

i_entryMode = input.string("VWAP Pullback", "Entry Trigger", options=["VWAP Pullback", "VWAP Cross"], group=grpEntry,
     tooltip="Pullback: wait for a shallow return to session VWAP that resumes trendward. Cross: enter on close crossing VWAP in the biased direction.")
i_longOnly  = input.bool(true, "Long Only Mode", group=grpEntry)
i_maxTrades = input.int(6, "Max Trades/Day", minval=1, maxval=20, group=grpEntry)
i_pullbackDist = input.float(0.15, "Max Pullback to VWAP %", step=0.05, group=grpEntry)
i_emaTrendLen  = input.int(34, "VWAP Regime EMA Length", group=grpEntry)
i_slopeLb      = input.int(3, "VWAP Regime EMA Slope Lookback", group=grpEntry)
i_requireLocal = input.bool(true, "Require 1H VWAP regime to agree", group=grpEntry,
     tooltip="Also require close vs session VWAP and 1H EMA slope to align with the 4H bias.")

i_atrLen  = input.int(14, "ATR Length", group=grpRisk)
i_slMult  = input.float(2.0, "SL Multiplier (x ATR)", step=0.1, group=grpRisk)
i_useTP   = input.bool(true, "Use ATR Take-Profit", group=grpRisk)
i_tpMult  = input.float(3.0, "TP Multiplier (x ATR)", step=0.1, group=grpRisk)
i_exitOnFlip = input.bool(true, "Exit When 4H Bias Flips Against Position", group=grpRisk)

i_useTrail = input.bool(true, "Use UT Bot Trailing Stop", group=grpTrail)
i_utKey    = input.float(1.0, "Trail Sensitivity", step=0.1, group=grpTrail)
i_utAtrLen = input.int(10, "Trail ATR Period", group=grpTrail)

i_fromDate = input.time(timestamp("1 Jan 2018 00:00 +0000"), "Backtest Start", group=grpFilt)
i_toDate   = input.time(timestamp("1 Jan 2099 00:00 +0000"), "Backtest End", group=grpFilt)
inWindow = time >= i_fromDate and time <= i_toDate

i_showDash  = input.bool(true, "Show Dashboard", group=grpVis)
i_scoreBars = input.bool(true, "Color Bars by Bias", group=grpVis)

// ------------------------------------------------- shared helper: VAR MA ---
// VIDYA-style adaptive MA used by TOTT and MACD ReLoaded (KivancOzbilgic).
varma(float s, simple int l) =>
    valpha = 2.0 / (l + 1)
    vud1 = s > s[1] ? s - s[1] : 0.0
    vdd1 = s < s[1] ? s[1] - s : 0.0
    vUD = math.sum(vud1, 9)
    vDD = math.sum(vdd1, 9)
    vCMO = nz((vUD - vDD) / (vUD + vDD))
    float v = 0.0
    v := nz(valpha * math.abs(vCMO) * s) + (1 - valpha * math.abs(vCMO)) * nz(v[1])
    v

// ============================================================================
//  HTF COMPONENTS  (calculated so they can be pulled at the 4H timeframe)
// ============================================================================

// --- 2. SuperTrend ---------------------------------------------------------
stAtr = ta.atr(i_stLen)
stUp = hl2 - i_stMult * stAtr
stUp1 = nz(stUp[1], stUp)
stUp := close[1] > stUp1 ? math.max(stUp, stUp1) : stUp
stDn = hl2 + i_stMult * stAtr
stDn1 = nz(stDn[1], stDn)
stDn := close[1] < stDn1 ? math.min(stDn, stDn1) : stDn
var int stTrend = 1
stTrend := stTrend == -1 and close > stDn1 ? 1 : stTrend == 1 and close < stUp1 ? -1 : stTrend
stDir = stTrend == 1 ? 1 : -1

// --- 3. Hull Suite ---------------------------------------------------------
hull = ta.hma(close, i_hullLen)
hullDir = hull > hull[2] ? 1 : hull < hull[2] ? -1 : 0

// --- 4. EMA cross ----------------------------------------------------------
emaDir = ta.ema(close, i_emaFast) > ta.ema(close, i_emaSlow) ? 1 : -1

// --- 5. Twin OTT -----------------------------------------------------------
tottMa = varma(close, i_tottLen)
fark = tottMa * i_tottPct * 0.01
longStop = tottMa - fark
longStopPrev = nz(longStop[1], longStop)
longStop := tottMa > longStopPrev ? math.max(longStop, longStopPrev) : longStop
shortStop = tottMa + fark
shortStopPrev = nz(shortStop[1], shortStop)
shortStop := tottMa < shortStopPrev ? math.min(shortStop, shortStopPrev) : shortStop
var int tottState = 1
tottState := tottState == -1 and tottMa > shortStopPrev ? 1 : tottState == 1 and tottMa < longStopPrev ? -1 : tottState
MT = tottState == 1 ? longStop : shortStop
OTT = tottMa > MT ? MT * (200 + i_tottPct) / 200 : MT * (200 - i_tottPct) / 200
OTTup = OTT * (1 + i_tottCoeff)
OTTdn = OTT * (1 - i_tottCoeff)
tottDir = tottMa > OTTup[2] ? 1 : tottMa < OTTdn[2] ? -1 : 0

// --- 6. MACD ReLoaded ------------------------------------------------------
macdLine = varma(close, i_macdFast) - varma(close, i_macdSlow)
macdHist = macdLine - varma(macdLine, i_macdTrig)
macdDir = macdHist > 0 ? 1 : macdHist < 0 ? -1 : 0

// --- pull the five component directions from the 4H timeframe (no repaint) --
[hSt, hHull, hEma, hTott, hMacd] = request.security(syminfo.tickerid, i_htf,
     [stDir[1], hullDir[1], emaDir[1], tottDir[1], macdDir[1]],
     lookahead=barmerge.lookahead_off)

htfBullScore = (hSt == 1 ? 1 : 0) + (hHull == 1 ? 1 : 0) + (hEma == 1 ? 1 : 0) + (hTott == 1 ? 1 : 0) + (hMacd == 1 ? 1 : 0)
htfBearScore = (hSt == -1 ? 1 : 0) + (hHull == -1 ? 1 : 0) + (hEma == -1 ? 1 : 0) + (hTott == -1 ? 1 : 0) + (hMacd == -1 ? 1 : 0)
htfBull = htfBullScore >= i_htfScore
htfBear = htfBearScore >= i_htfScore

// ============================================================================
//  CHART-TIMEFRAME ENGINE  (1H VWAP Trend Momentum: timing + risk)
// ============================================================================
newDay = ta.change(time("D")) != 0
var float svNum = 0.0
var float svDen = 0.0
var float sVwap = na
var int tCount = 0
if newDay
    svNum := 0.0
    svDen := 0.0
    tCount := 0
svNum += ((high + low + close) / 3.0) * math.max(volume, 1.0)
svDen += math.max(volume, 1.0)
sVwap := svDen > 0 ? svNum / svDen : close

emaTrend = ta.ema(close, i_emaTrendLen)
emaSlope = emaTrend - emaTrend[i_slopeLb]
localBull = not na(sVwap) and close > sVwap and emaSlope > 0
localBear = not na(sVwap) and close < sVwap and emaSlope < 0

atr = ta.atr(i_atrLen)

// --- UT Bot trailing stop (chart timeframe) --------------------------------
utAtr = ta.atr(i_utAtrLen)
utLoss = i_utKey * utAtr
var float utTrail = 0.0
utPrev = utTrail[1]
if close > utPrev and close[1] > utPrev
    utTrail := math.max(utPrev, close - utLoss)
else if close < utPrev and close[1] < utPrev
    utTrail := math.min(utPrev, close + utLoss)
else if close > utPrev
    utTrail := close - utLoss
else
    utTrail := close + utLoss

// --- VWAP entry triggers ---------------------------------------------------
vwapDist = not na(sVwap) ? math.abs(close - sVwap) / close * 100 : 99.0
nearVwap = vwapDist <= i_pullbackDist
wasNearVwap = nearVwap or nearVwap[1] or nearVwap[2] or nearVwap[3]
bounceLong  = wasNearVwap and close > sVwap and close > high[1]
bounceShort = wasNearVwap and close < sVwap and close < low[1]
crossUpVwap   = ta.crossover(close, sVwap)
crossDnVwap   = ta.crossunder(close, sVwap)

trigLong  = i_entryMode == "VWAP Pullback" ? bounceLong  : crossUpVwap
trigShort = i_entryMode == "VWAP Pullback" ? bounceShort : crossDnVwap

// --- bias gate + local agreement -------------------------------------------
biasLong  = htfBull and (not i_requireLocal or localBull)
biasShort = htfBear and (not i_requireLocal or localBear)

canTrade = inWindow and tCount < i_maxTrades and strategy.position_size == 0 and not na(atr) and atr > 0
goLong  = canTrade and biasLong and trigLong
goShort = canTrade and biasShort and trigShort and not i_longOnly

var float slPrice = na
var float tpPrice = na
if goLong
    slPrice := close - atr * i_slMult
    tpPrice := close + atr * i_tpMult
    strategy.entry("Long", strategy.long)
    tCount += 1
    alert("BUY " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + " | 4H bias " + str.tostring(htfBullScore) + "/5 | TP: " + str.tostring(tpPrice, format.mintick) + " | SL: " + str.tostring(slPrice, format.mintick), alert.freq_once_per_bar)
if goShort
    slPrice := close + atr * i_slMult
    tpPrice := close - atr * i_tpMult
    strategy.entry("Short", strategy.short)
    tCount += 1
    alert("SELL " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + " | 4H bias " + str.tostring(htfBearScore) + "/5 | TP: " + str.tostring(tpPrice, format.mintick) + " | SL: " + str.tostring(slPrice, format.mintick), alert.freq_once_per_bar)

// --- exits: ATR stop/target + UT Bot trail + HTF bias flip -----------------
if strategy.position_size > 0
    float stopLvlL = i_useTrail ? math.max(slPrice, utTrail) : slPrice
    strategy.exit("XL", "Long", stop=stopLvlL, limit=i_useTP ? tpPrice : na)
    if i_exitOnFlip and htfBear
        strategy.close("Long", comment="4H Bias Flip")
if strategy.position_size < 0
    float stopLvlS = i_useTrail ? math.min(slPrice, utTrail) : slPrice
    strategy.exit("XS", "Short", stop=stopLvlS, limit=i_useTP ? tpPrice : na)
    if i_exitOnFlip and htfBull
        strategy.close("Short", comment="4H Bias Flip")

// ------------------------------------------------------------------ plots --
plot(sVwap, "Session VWAP (1H)", color=color.new(C_GOLD, 10), linewidth=2)
plot(strategy.position_size != 0 ? utTrail : na, "UT Trail", style=plot.style_linebr, color=color.new(C_ORANGE, 20), linewidth=2)
vwapHi = not na(sVwap) ? sVwap * (1 + i_pullbackDist / 100) : na
vwapLo = not na(sVwap) ? sVwap * (1 - i_pullbackDist / 100) : na
pVH = plot(vwapHi, "VWAP+", color=color.new(C_GOLD, 75), style=plot.style_linebr)
pVL = plot(vwapLo, "VWAP-", color=color.new(C_GOLD, 75), style=plot.style_linebr)
fill(pVH, pVL, color=color.new(C_GOLD, 93), title="Pullback Zone")

plotshape(goLong, "Buy", shape.labelup, location.belowbar, color=color.new(C_BULL, 0), text="BUY", textcolor=color.new(#0e1726, 0), size=size.small)
plotshape(goShort, "Sell", shape.labeldown, location.abovebar, color=color.new(C_BEAR, 0), text="SELL", textcolor=color.new(C_WHITE, 0), size=size.small)

biasColor = htfBull ? C_NEON : htfBear ? C_RED : htfBullScore > htfBearScore ? color.new(C_BULL, 45) : htfBearScore > htfBullScore ? color.new(C_ORANGE, 45) : C_DIM
barcolor(i_scoreBars ? biasColor : na)
bgcolor(htfBull ? color.new(C_BULL, 96) : htfBear ? color.new(C_BEAR, 96) : na, title="4H Bias BG")

// -------------------------------------------------------------- dashboard --
stateTxt(int d) => d == 1 ? "BULL" : d == -1 ? "BEAR" : "----"
stateCol(int d) => d == 1 ? C_BULL : d == -1 ? C_BEAR : C_DIM
var table t = table.new(position.top_right, 2, 9, bgcolor=color.new(C_PANEL, 0), border_color=C_BORDER, border_width=1, frame_color=C_BORDER, frame_width=2)
if i_showDash and barstate.islast
    table.cell(t, 0, 0, "4H COMPONENT", text_color=C_SILVER, text_size=size.small)
    table.cell(t, 1, 0, "STATE", text_color=C_SILVER, text_size=size.small)
    table.cell(t, 0, 1, "SuperTrend", text_color=C_WHITE, text_size=size.tiny)
    table.cell(t, 1, 1, stateTxt(hSt), text_color=stateCol(hSt), text_size=size.tiny)
    table.cell(t, 0, 2, "Hull-55", text_color=C_WHITE, text_size=size.tiny)
    table.cell(t, 1, 2, stateTxt(hHull), text_color=stateCol(hHull), text_size=size.tiny)
    table.cell(t, 0, 3, "EMA 10/20", text_color=C_WHITE, text_size=size.tiny)
    table.cell(t, 1, 3, stateTxt(hEma), text_color=stateCol(hEma), text_size=size.tiny)
    table.cell(t, 0, 4, "TOTT", text_color=C_WHITE, text_size=size.tiny)
    table.cell(t, 1, 4, stateTxt(hTott), text_color=stateCol(hTott), text_size=size.tiny)
    table.cell(t, 0, 5, "MACD-VAR", text_color=C_WHITE, text_size=size.tiny)
    table.cell(t, 1, 5, stateTxt(hMacd), text_color=stateCol(hMacd), text_size=size.tiny)
    table.cell(t, 0, 6, "1H VWAP Regime", text_color=C_WHITE, text_size=size.tiny)
    localDir = localBull ? 1 : localBear ? -1 : 0
    table.cell(t, 1, 6, stateTxt(localDir), text_color=stateCol(localDir), text_size=size.tiny)
    table.cell(t, 0, 7, "4H BIAS", text_color=C_GOLD, text_size=size.small)
    table.cell(t, 1, 7, str.tostring(htfBullScore) + "▲ / " + str.tostring(htfBearScore) + "▼", text_color=htfBull ? C_NEON : htfBear ? C_RED : C_WHITE, text_size=size.small)
    table.cell(t, 0, 8, "POS / TRADES", text_color=C_DIM, text_size=size.tiny)
    posTxt = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    table.cell(t, 1, 8, posTxt + "  " + str.tostring(tCount) + "/" + str.tostring(i_maxTrades), text_color=strategy.position_size > 0 ? C_BULL : strategy.position_size < 0 ? C_BEAR : C_SILVER, text_size=size.tiny)
