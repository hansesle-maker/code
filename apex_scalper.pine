//@version=6
strategy("⚡ APEX Multi-Confluence Scalper", shorttitle="⚡ APEX",
         overlay=true, initial_capital=10000,
         default_qty_type=strategy.fixed, default_qty_value=1,
         commission_type=strategy.commission.percent, commission_value=0.05,
         slippage=2, calc_on_every_tick=false, process_orders_on_close=true)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════
g1 = "📐 Trend Engine"
maType  = input.string("EMA", "MA Type", options=["EMA","SMA","WMA","HMA","VWMA"], group=g1,
                       tooltip="HMA(Hull) = 빠르고 부드러움 / VWMA = 거래량 가중 / EMA = 기본")
maFastL = input.int(9,    "Fast MA Length",        minval=1, group=g1)
maSlowL = input.int(21,   "Slow MA Length",        minval=1, group=g1)
stLen   = input.int(10,   "Supertrend ATR Length", minval=1, group=g1)
stMult  = input.float(3.0,"Supertrend Multiplier", minval=0.1, step=0.1, group=g1)

g2 = "🎯 Momentum Engine"
momType = input.string("TSI", "Momentum Type",
                       options=["Stoch RSI","RSI","TSI","MACD","CCI","MFI"], group=g2,
                       tooltip="TSI = 이중 스무딩, 노이즈 ↓ / MACD = 추세+모멘텀 / MFI = 거래량 반영 RSI")
momFast = input.int(14, "Fast Length",    minval=2, group=g2,
                    tooltip="Stoch RSI: RSI기간 | RSI: 기간 | TSI: fast(권장25) | MACD: fast(권장12) | CCI/MFI: 기간")
momSlow = input.int(3,  "Slow / Smooth", minval=1, group=g2,
                    tooltip="Stoch RSI: K smooth | TSI: slow(권장13) | MACD: slow(권장26)")
momSig  = input.int(3,  "Signal / D",    minval=1, group=g2,
                    tooltip="Stoch RSI: D smooth | TSI: signal EMA(권장13) | MACD: signal(권장9)")
momOB   = input.int(80, "Overbought Level", minval=50, maxval=100, group=g2)
momOS   = input.int(20, "Oversold Level",   minval=0,  maxval=50,  group=g2)

g3 = "📊 Volume & VWAP"
volLen  = input.int(20,    "Volume MA Length",        minval=5, group=g3)
volMult = input.float(1.2, "Volume Threshold (×avg)", minval=1.0, step=0.1, group=g3)
useVWAP = input.bool(true, "VWAP Side Filter",        group=g3)

g4 = "💰 Risk Management"
atrLen       = input.int(14,    "ATR Length",           minval=1, group=g4)
slMult       = input.float(1.5, "SL ATR Multiple",      minval=0.1, step=0.1, group=g4)
riskPct      = input.float(1.0, "Risk Per Trade %",     minval=0.1, maxval=10, step=0.1, group=g4)
useBE        = input.bool(true,  "Move SL to BE after TP1", group=g4)
useTrail     = input.bool(false, "Trailing Stop (replaces TP2~4)", group=g4,
                          tooltip="TP1 이후 ATR 거리만큼 뒤따르는 트레일링 스탑. ON이면 TP2~TP4 무시.")
trailMult    = input.float(1.5, "↳ Trailing Stop ATR Multiple", minval=0.1, step=0.1, group=g4)

useTP1  = input.bool(true,  "TP1 Enable", group=g4)
tp1Mult = input.float(1.5,  "↳ TP1 ATR Multiple", minval=0.1, step=0.1, group=g4)
tp1Pct  = input.float(50.0, "↳ TP1 Exit %",       minval=1, maxval=99, step=1, group=g4)

useTP2  = input.bool(true,  "TP2 Enable", group=g4)
tp2Mult = input.float(3.0,  "↳ TP2 ATR Multiple", minval=0.1, step=0.1, group=g4)
tp2Pct  = input.float(30.0, "↳ TP2 Exit %",       minval=1, maxval=99, step=1, group=g4)

useTP3  = input.bool(false, "TP3 Enable", group=g4)
tp3Mult = input.float(4.0,  "↳ TP3 ATR Multiple", minval=0.1, step=0.1, group=g4)
tp3Pct  = input.float(20.0, "↳ TP3 Exit %",       minval=1, maxval=99, step=1, group=g4)

useTP4  = input.bool(false, "TP4 Enable", group=g4)
tp4Mult = input.float(6.0,  "↳ TP4 ATR Multiple", minval=0.1, step=0.1, group=g4)
tp4Pct  = input.float(10.0, "↳ TP4 Exit % (rest always closes)", minval=1, maxval=99, step=1, group=g4)

useScoreSize = input.bool(false, "Score-Based Position Sizing", group=g4,
                          tooltip="컨플루언스 점수에 비례해 포지션 크기 조정")
scoreMultMin = input.float(0.5, "↳ Min Size Multiplier", minval=0.1, maxval=5.0, step=0.1, group=g4)
scoreMultMax = input.float(1.5, "↳ Max Size Multiplier", minval=0.1, maxval=5.0, step=0.1, group=g4)

g5 = "🔧 Signal Filter"
minScore = input.int(5, "Min Confluence Score (max 6, or 7 with P/V)", minval=1, maxval=7, group=g5)
minBars  = input.int(5, "Min Bars Between Signals", minval=0, group=g5)

usePivot   = input.bool(true, "Peak/Valley as Confluence Factor (+1 point)", group=g5,
                         tooltip="피벗 저점(롱) / 피벗 고점(숏) 발생 N봉 내에 있으면 스코어 +1점\n기본 6점 만점 → 7점 만점으로 상향 (진입 차단이 아닌 품질 가중)")
pivotLeft  = input.int(5,  "↳ Pivot Left Bars",      minval=2, maxval=30, group=g5)
pivotRight = input.int(2,  "↳ Pivot Right Bars",     minval=1, maxval=10, group=g5,
                        tooltip="클수록 확인 늦어지지만 정확. 작을수록 빠르지만 노이즈 증가")
pivotProx  = input.int(10, "↳ Max Bars Since Pivot", minval=2, maxval=50, group=g5,
                        tooltip="피벗 발생 후 최대 N봉 내에 있어야 +1점")

useCircuitBreaker = input.bool(true, "Consecutive Loss Circuit Breaker", group=g5,
                               tooltip="N번 연속 손실 후 다음 신호 차단 — MDD 억제")
maxConsecLoss     = input.int(3, "↳ Max Consecutive Losses", minval=1, maxval=10, group=g5)

useAtrSpike  = input.bool(true,  "Block Extreme Volatility (ATR Spike)", group=g5,
                           tooltip="ATR이 평균의 N배 이상이면 진입 차단 — 크래시/급등 회피")
atrSpikeLen  = input.int(50,    "↳ ATR Avg Length",             minval=10, group=g5)
atrSpikeMult = input.float(2.5, "↳ Spike Threshold (×avg ATR)", minval=1.0, step=0.1, group=g5)

g7 = "🔭 Regime & MTF Filter"
useADX       = input.bool(true,   "ADX Trend Filter", group=g7,
                          tooltip="ADX 미만 구간(횡보장) 진입 차단")
adxLen       = input.int(14,      "↳ ADX Length",        minval=5, group=g7)
adxMin       = input.float(20.0,  "↳ Min ADX Threshold", minval=5, maxval=60, step=1.0, group=g7)
useDailyBias = input.bool(true,   "Daily EMA200 Bias Filter", group=g7,
                          tooltip="일봉 EMA200 위면 롱만, 아래면 숏만 허용")
dailyEmaLen  = input.int(200,     "↳ Daily EMA Length", minval=20, group=g7)
useMTF       = input.bool(true,   "Higher TF Confirmation", group=g7,
                          tooltip="상위 TF Supertrend가 반대 방향이면 진입 차단")
mtfTF        = input.timeframe("240", "↳ Higher Timeframe", group=g7)

gBT       = "📅 Backtest Range"
useRange  = input.bool(false, "Limit Backtest Period", group=gBT,
                        tooltip="ON이면 아래 기간에만 백테스트 적용. 트레이딩뷰 거래내역이 자동 필터됨.")
startDate = input.time(timestamp("2020 01 01 00:00"), "Start Date", group=gBT)
endDate   = input.time(timestamp("2025 12 31 23:59"), "End Date",   group=gBT)

g6 = "🎨 Visuals"
showEMA    = input.bool(true, "Show MAs",           group=g6)
showST     = input.bool(true, "Show Supertrend",    group=g6)
showLevels = input.bool(true, "Show SL/TP Labels",  group=g6)
showPivots = input.bool(true, "Show Pivot Markers", group=g6)
showDash   = input.bool(true, "Show Dashboard",     group=g6)

// ═══════════════════════════════════════════════════════════════════════════════
// CORE CALCULATIONS
// ═══════════════════════════════════════════════════════════════════════════════

// ── Backtest date gate ────────────────────────────────────────────────────────
inRange = not useRange or (time >= startDate and time <= endDate)

// ── MA function ───────────────────────────────────────────────────────────────
calcMA(src, len, typ) =>
    float result = na
    if typ == "SMA"
        result := ta.sma(src, len)
    else if typ == "WMA"
        result := ta.wma(src, len)
    else if typ == "HMA"
        result := ta.hma(src, len)
    else if typ == "VWMA"
        result := ta.vwma(src, len)
    else
        result := ta.ema(src, len)
    result

maFast = calcMA(close, maFastL, maType)
maSlow = calcMA(close, maSlowL, maType)

[stLine, stDir] = ta.supertrend(stMult, stLen)
stBull = stDir < 0
stBear = stDir > 0

atr = ta.atr(atrLen)

volMA     = ta.sma(volume, volLen)
volOK     = volume > volMA * volMult
vwap      = ta.vwap(hlc3)
aboveVWAP = close > vwap
belowVWAP = close < vwap

// ── Momentum calculations ─────────────────────────────────────────────────────
rsiVal = ta.rsi(close, momFast)

srsiLow  = ta.lowest(rsiVal, momFast)
srsiHigh = ta.highest(rsiVal, momFast)
srsiRaw  = srsiHigh != srsiLow ? (rsiVal - srsiLow) / (srsiHigh - srsiLow) * 100 : 50.0
kVal     = ta.sma(srsiRaw, momSlow)
dVal     = ta.sma(kVal, momSig)

tsiM    = close - close[1]
tsiEma1 = ta.ema(ta.ema(tsiM, momFast), momSlow)
tsiEma2 = ta.ema(ta.ema(math.abs(tsiM), momFast), momSlow)
tsiVal  = tsiEma2 != 0 ? tsiEma1 / tsiEma2 * 100 : 0.0
tsiSig  = ta.ema(tsiVal, momSig)

[macdLine, macdSigLine, _] = ta.macd(close, momFast, momSlow, momSig)
cciVal = ta.cci(close, momFast)
mfiVal = ta.mfi(hlc3, momFast)

// ── Momentum cross signals (factor 3) ────────────────────────────────────────
srsiCrossUp   = ta.crossover(kVal, dVal) and kVal < momOB
srsiCrossDown = ta.crossunder(kVal, dVal) and kVal > momOS
rsiCrossUp    = ta.crossover(rsiVal, momOS)
rsiCrossDown  = ta.crossunder(rsiVal, momOB)
tsiCrossUp    = ta.crossover(tsiVal, tsiSig) and tsiVal < 0
tsiCrossDown  = ta.crossunder(tsiVal, tsiSig) and tsiVal > 0
macdCrossUp   = ta.crossover(macdLine, macdSigLine) and macdLine < 0
macdCrossDown = ta.crossunder(macdLine, macdSigLine) and macdLine > 0
cciCrossUp    = ta.crossover(cciVal, float(-100))
cciCrossDown  = ta.crossunder(cciVal, float(100))
mfiCrossUp    = ta.crossover(mfiVal, float(momOS))
mfiCrossDown  = ta.crossunder(mfiVal, float(momOB))

momCrossUp = switch momType
    "Stoch RSI" => srsiCrossUp
    "RSI"       => rsiCrossUp
    "TSI"       => tsiCrossUp
    "MACD"      => macdCrossUp
    "CCI"       => cciCrossUp
    "MFI"       => mfiCrossUp
    => false

momCrossDown = switch momType
    "Stoch RSI" => srsiCrossDown
    "RSI"       => rsiCrossDown
    "TSI"       => tsiCrossDown
    "MACD"      => macdCrossDown
    "CCI"       => cciCrossDown
    "MFI"       => mfiCrossDown
    => false

// ── Momentum velocity (dashboard label only) ─────────────────────────────────
momLine = switch momType
    "Stoch RSI" => kVal
    "RSI"       => rsiVal
    "TSI"       => tsiVal
    "MACD"      => macdLine
    "CCI"       => cciVal
    "MFI"       => mfiVal
    => 0.0

// ── RSI-14 Trend Bias (factor 6) — independent of selected momType ───────────
// Replaces risingMom: measures whether price is in bull/bear regime on RSI scale.
// Crossover (F3) tells you WHEN to enter; RSI>50 tells you WHETHER trend supports it.
rsi14Val  = ta.rsi(close, 14)
rsi14Bull = rsi14Val > 50
rsi14Bear = rsi14Val < 50

// ── Regime Filters ────────────────────────────────────────────────────────────
[_, _, adxVal] = ta.dmi(adxLen, adxLen)
adxOK = not useADX or adxVal >= adxMin

dailyEma200 = request.security(syminfo.tickerid, "D", ta.ema(close, dailyEmaLen), lookahead=barmerge.lookahead_off)
bullBias    = not useDailyBias or close > dailyEma200
bearBias    = not useDailyBias or close < dailyEma200

[_, mtfStDir] = request.security(syminfo.tickerid, mtfTF, ta.supertrend(stMult, stLen), lookahead=barmerge.lookahead_off)
mtfBull       = mtfStDir < 0
mtfBear       = mtfStDir > 0
mtfLongOK     = not useMTF or mtfBull
mtfShortOK    = not useMTF or mtfBear

// ── ATR Spike Filter ──────────────────────────────────────────────────────────
atrAvg     = ta.sma(atr, atrSpikeLen)
atrSpikeOK = not useAtrSpike or atr <= atrAvg * atrSpikeMult

// ── Peak / Valley — scoring factor 7 (0 if usePivot=false) ───────────────────
pivHigh = ta.pivothigh(high, pivotLeft, pivotRight)
pivLow  = ta.pivotlow(low,  pivotLeft, pivotRight)

barsSincePivLow  = ta.barssince(not na(pivLow))
barsSincePivHigh = ta.barssince(not na(pivHigh))

pivotLongFactor  = usePivot and not na(barsSincePivLow)  and barsSincePivLow  <= pivotProx ? 1 : 0
pivotShortFactor = usePivot and not na(barsSincePivHigh) and barsSincePivHigh <= pivotProx ? 1 : 0

// ── Consecutive Loss Circuit Breaker ──────────────────────────────────────────
var int  consecLoss = 0
var bool cbBlocked  = false

if strategy.closedtrades > 0
    lastPnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if lastPnl < 0
        consecLoss := consecLoss + 1
    else
        consecLoss := 0

cbBlocked := useCircuitBreaker and consecLoss >= maxConsecLoss

// ═══════════════════════════════════════════════════════════════════════════════
// CONFLUENCE SCORING
// Factor 1: MA alignment   2: Supertrend   3: Momentum cross
// Factor 4: Volume         5: VWAP side    6: Momentum velocity
// Factor 7: Peak/Valley recency (+1 if usePivot=ON and within pivotProx bars)
// ═══════════════════════════════════════════════════════════════════════════════
maxScore = usePivot ? 7 : 6

longFactors  = array.from(maFast > maSlow ? 1 : 0, stBull ? 1 : 0, momCrossUp   ? 1 : 0, volOK ? 1 : 0, aboveVWAP ? 1 : 0, rsi14Bull ? 1 : 0, pivotLongFactor)
shortFactors = array.from(maFast < maSlow ? 1 : 0, stBear ? 1 : 0, momCrossDown ? 1 : 0, volOK ? 1 : 0, belowVWAP ? 1 : 0, rsi14Bear ? 1 : 0, pivotShortFactor)

longScore  = array.sum(longFactors)
shortScore = array.sum(shortFactors)

// ═══════════════════════════════════════════════════════════════════════════════
// ENTRY CONDITIONS
// ═══════════════════════════════════════════════════════════════════════════════
var int barsSince = 999
barsSince += 1

_flat     = strategy.position_size == 0
_cooldown = barsSince >= minBars
_regime   = adxOK and atrSpikeOK and not cbBlocked

longBase  = longScore  >= minScore and longScore  >= shortScore and _flat and _cooldown
longExtra = _regime and bullBias and mtfLongOK
longCond  = longBase and longExtra and inRange

shortBase  = shortScore >= minScore and shortScore > longScore  and _flat and _cooldown
shortExtra = _regime and bearBias and mtfShortOK
shortCond  = shortBase and shortExtra and inRange

if longCond or shortCond
    barsSince  := 0
    consecLoss := 0

// ═══════════════════════════════════════════════════════════════════════════════
// POSITION MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════════
calcQty(slDist, score) =>
    base = slDist > 0 ? (strategy.equity * riskPct / 100) / slDist : 1.0
    topS = usePivot ? 7 : 6
    if useScoreSize and topS > minScore
        t = math.max(0.0, math.min(1.0, (float(score) - float(minScore)) / float(topS - minScore)))
        base * (scoreMultMin + (scoreMultMax - scoreMultMin) * t)
    else
        base

tpChainPct(p1, p2, p3, p4, level) =>
    float result = 100.0
    if level == 1
        result := p1
    else if level == 2
        rem1 = 100.0 - p1
        result := rem1 > 0 ? math.min(100.0, p2 / rem1 * 100.0) : 100.0
    else if level == 3
        rem2 = 100.0 - p1 - p2
        result := rem2 > 0 ? math.min(100.0, p3 / rem2 * 100.0) : 100.0
    else if level == 4
        rem3 = 100.0 - p1 - p2 - p3
        result := rem3 > 0 ? math.min(100.0, p4 / rem3 * 100.0) : 100.0
    result

lastActiveTP() =>
    int last = 1
    if useTP4
        last := 4
    else if useTP3
        last := 3
    else if useTP2
        last := 2
    else
        last := 1
    last

placeExits(dir, slP, tp1P, tp2P, tp3P, tp4P) =>
    pfx = dir == 1 ? "L" : "S"
    nm  = dir == 1 ? "Long" : "Short"
    if useTrail
        trailTicks = math.round(atr * trailMult / syminfo.mintick)
        if useTP1
            strategy.exit(pfx + "_TP1", nm, qty_percent=tp1Pct, limit=tp1P, stop=slP)
        strategy.exit(pfx + "_TRAIL", nm, qty_percent=100, stop=slP, trail_price=tp1P, trail_offset=trailTicks)
    else
        lastTP = lastActiveTP()
        if useTP1
            pct1 = lastTP == 1 ? 100.0 : tpChainPct(tp1Pct, tp2Pct, tp3Pct, tp4Pct, 1)
            strategy.exit(pfx + "_TP1", nm, qty_percent=pct1, limit=tp1P, stop=slP)
        if useTP2
            pct2 = lastTP == 2 ? 100.0 : tpChainPct(tp1Pct, tp2Pct, tp3Pct, tp4Pct, 2)
            strategy.exit(pfx + "_TP2", nm, qty_percent=pct2, limit=tp2P, stop=slP)
        if useTP3
            pct3 = lastTP == 3 ? 100.0 : tpChainPct(tp1Pct, tp2Pct, tp3Pct, tp4Pct, 3)
            strategy.exit(pfx + "_TP3", nm, qty_percent=pct3, limit=tp3P, stop=slP)
        if useTP4
            strategy.exit(pfx + "_TP4", nm, qty_percent=100, limit=tp4P, stop=slP)
        if not useTP1 and not useTP2 and not useTP3 and not useTP4
            strategy.exit(pfx + "_SL", nm, qty_percent=100, stop=slP)

var float slPx       = na
var float tp1Px      = na
var float tp2Px      = na
var float tp3Px      = na
var float tp4Px      = na
var int   tpHitCount = 0
var float prevPos    = 0.0

maxScoStr = str.tostring(maxScore)

if longCond
    slPx  := close - atr * slMult
    tp1Px := close + atr * tp1Mult
    tp2Px := close + atr * tp2Mult
    tp3Px := close + atr * tp3Mult
    tp4Px := close + atr * tp4Mult
    tpHitCount := 0
    qty = calcQty(atr * slMult, longScore)
    strategy.entry("Long", strategy.long, qty=qty, comment="▲ " + str.tostring(longScore) + "/" + maxScoStr)
    placeExits(1, slPx, tp1Px, tp2Px, tp3Px, tp4Px)

if shortCond
    slPx  := close + atr * slMult
    tp1Px := close - atr * tp1Mult
    tp2Px := close - atr * tp2Mult
    tp3Px := close - atr * tp3Mult
    tp4Px := close - atr * tp4Mult
    tpHitCount := 0
    qty = calcQty(atr * slMult, shortScore)
    strategy.entry("Short", strategy.short, qty=qty, comment="▼ " + str.tostring(shortScore) + "/" + maxScoStr)
    placeExits(-1, slPx, tp1Px, tp2Px, tp3Px, tp4Px)

longTP1Hit  = not useTrail and strategy.position_size > 0 and prevPos > 0 and strategy.position_size < prevPos * 0.85 and tpHitCount == 0
shortTP1Hit = not useTrail and strategy.position_size < 0 and prevPos < 0 and strategy.position_size > prevPos * 0.85 and tpHitCount == 0

if longTP1Hit and useBE
    tpHitCount := 1
    strategy.exit("L_TP2_BE", "Long",  qty_percent=100, limit=tp2Px, stop=strategy.position_avg_price)
if shortTP1Hit and useBE
    tpHitCount := 1
    strategy.exit("S_TP2_BE", "Short", qty_percent=100, limit=tp2Px, stop=strategy.position_avg_price)

prevPos := strategy.position_size

// ═══════════════════════════════════════════════════════════════════════════════
// VISUALS
// ═══════════════════════════════════════════════════════════════════════════════
plot(showEMA ? maFast : na, "MA Fast", color.new(#00BFFF, 0), linewidth=1)
plot(showEMA ? maSlow : na, "MA Slow", color.new(#FF6B6B, 0), linewidth=1)
emaFill1 = plot(showEMA ? maFast : na, display=display.none)
emaFill2 = plot(showEMA ? maSlow : na, display=display.none)
fill(emaFill1, emaFill2, color=showEMA ? (maFast > maSlow ? color.new(color.lime, 88) : color.new(color.red, 88)) : na)

plot(showST ? stLine : na, "Supertrend", stBull ? color.new(color.lime, 20) : color.new(color.red, 20), linewidth=2)
plot(useVWAP ? vwap : na, "VWAP", color.new(color.orange, 0), linewidth=1, style=plot.style_circles)

plotshape(showPivots and not na(pivLow),  "Valley ▽", shape.triangleup,   location.belowbar, color.new(color.aqua,    30), size=size.tiny)
plotshape(showPivots and not na(pivHigh), "Peak △",   shape.triangledown, location.abovebar, color.new(color.fuchsia, 30), size=size.tiny)

plotshape(longCond,  "▲ Long",  shape.triangleup,   location.belowbar, color.new(color.lime, 0), size=size.normal)
plotshape(shortCond, "▼ Short", shape.triangledown, location.abovebar, color.new(color.red,  0), size=size.normal)
plotshape(showLevels and cbBlocked and _flat, "⛔ CB", shape.xcross, location.abovebar, color.new(color.orange, 20), size=size.tiny)

if longCond and showLevels
    ltp1s  = useTP1 ? "\nTP1 " + str.tostring(tp1Px, format.mintick) : ""
    ltp2s  = useTP2 ? "\nTP2 " + str.tostring(tp2Px, format.mintick) : ""
    ltp3s  = useTP3 ? "\nTP3 " + str.tostring(tp3Px, format.mintick) : ""
    ltp4s  = useTP4 ? "\nTP4 " + str.tostring(tp4Px, format.mintick) : ""
    ltpStr = ltp1s + ltp2s + ltp3s + ltp4s
    label.new(bar_index, low - atr * 0.3,
              str.tostring(longScore) + "/" + maxScoStr + " ▲" + ltpStr + "\nSL  " + str.tostring(slPx, format.mintick),
              color=color.new(#0d3b1e, 10), textcolor=color.lime, style=label.style_label_up, size=size.tiny)
if shortCond and showLevels
    stp1s  = useTP1 ? "\nTP1 " + str.tostring(tp1Px, format.mintick) : ""
    stp2s  = useTP2 ? "\nTP2 " + str.tostring(tp2Px, format.mintick) : ""
    stp3s  = useTP3 ? "\nTP3 " + str.tostring(tp3Px, format.mintick) : ""
    stp4s  = useTP4 ? "\nTP4 " + str.tostring(tp4Px, format.mintick) : ""
    stpStr = stp1s + stp2s + stp3s + stp4s
    label.new(bar_index, high + atr * 0.3,
              str.tostring(shortScore) + "/" + maxScoStr + " ▼" + stpStr + "\nSL  " + str.tostring(slPx, format.mintick),
              color=color.new(#3b0d0d, 10), textcolor=color.red, style=label.style_label_down, size=size.tiny)

posColor = strategy.position_size > 0 ? color.new(color.lime, 96) : strategy.position_size < 0 ? color.new(color.red, 96) : na
bgcolor(posColor)
bgcolor(useADX and adxVal < adxMin ? color.new(color.gray, 93) : na, title="Ranging Zone")
bgcolor(useAtrSpike and atr > atrAvg * atrSpikeMult ? color.new(color.purple, 93) : na, title="ATR Spike Zone")
bgcolor(useRange and not inRange ? color.new(color.navy, 96) : na, title="Out of Range")

// ═══════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ═══════════════════════════════════════════════════════════════════════════════
scoreBar(score, maxS) =>
    s = ""
    for i = 1 to score
        s := s + "█"
    for i = score + 1 to maxS
        s := s + "░"
    s

momLineLbl = switch momType
    "Stoch RSI" => "K:" + str.tostring(kVal, "#.0") + " D:" + str.tostring(dVal, "#.0")
    "RSI"       => str.tostring(rsiVal, "#.1")
    "TSI"       => str.tostring(tsiVal, "#.2") + " S:" + str.tostring(tsiSig, "#.2")
    "MACD"      => str.tostring(macdLine, "#.4")
    "CCI"       => str.tostring(cciVal, "#.1")
    "MFI"       => str.tostring(mfiVal, "#.1")
    => "—"

var table dash = na
if showDash and barstate.islast
    if not na(dash)
        table.delete(dash)
    numRows = usePivot ? 31 : 30
    dash := table.new(position.top_right, 2, numRows,
                      bgcolor=color.new(#0d1117, 5),
                      border_color=color.new(color.gray, 55), border_width=1)
    cg  = #B2B5BE
    cw  = color.white
    cgr = #26A69A
    cre = #EF5350
    cyl = #FFD700
    hdr = color.new(#0d1117, 0)
    lbl = size.tiny
    val = size.small

    table.merge_cells(dash, 0, 0, 1, 0)
    table.cell(dash, 0, 0, "⚡ APEX Scalper v6", text_color=cw, bgcolor=hdr, text_size=val, text_halign=text.align_center)

    wr = strategy.wintrades + strategy.losstrades > 0 ? strategy.wintrades / (strategy.wintrades + strategy.losstrades) * 100 : 0.0
    table.cell(dash, 0, 1, "Net P&L",     text_color=cg, text_size=lbl)
    table.cell(dash, 1, 1, "$" + str.tostring(strategy.netprofit, "#.0"), text_color=strategy.netprofit >= 0 ? cgr : cre, text_size=lbl, text_halign=text.align_right)
    table.cell(dash, 0, 2, "Win Rate",    text_color=cg, text_size=lbl)
    table.cell(dash, 1, 2, str.tostring(wr, "#.1") + "%", text_color=wr >= 55 ? cgr : wr >= 40 ? cyl : cre, text_size=lbl, text_halign=text.align_right)
    table.cell(dash, 0, 3, "Trades",      text_color=cg, text_size=lbl)
    table.cell(dash, 1, 3, str.tostring(strategy.closedtrades), text_color=cg, text_size=lbl, text_halign=text.align_right)
    table.cell(dash, 0, 4, "Max DD",      text_color=cg, text_size=lbl)
    table.cell(dash, 1, 4, str.tostring(strategy.max_drawdown, "#.0"), text_color=cre, text_size=lbl, text_halign=text.align_right)
    table.cell(dash, 0, 5, "Consec Loss", text_color=cg, text_size=lbl)
    table.cell(dash, 1, 5, str.tostring(consecLoss) + (cbBlocked ? " ⛔" : ""), text_color=consecLoss >= maxConsecLoss ? cre : consecLoss > 0 ? cyl : cgr, text_size=lbl, text_halign=text.align_right)

    table.merge_cells(dash, 0, 6, 1, 6)
    table.cell(dash, 0, 6, "── Confluence ──", text_color=cyl, text_size=lbl, text_halign=text.align_center)

    lBar = scoreBar(longScore,  maxScore)
    sBar = scoreBar(shortScore, maxScore)
    lFrac = str.tostring(longScore)  + "/" + maxScoStr
    sFrac = str.tostring(shortScore) + "/" + maxScoStr
    table.cell(dash, 0, 7, "Long  " + lBar, text_color=longScore  >= 5 ? cgr : longScore  >= 3 ? cyl : cg, text_size=lbl)
    table.cell(dash, 1, 7, lFrac,           text_color=longScore  >= minScore ? cgr : cg, text_size=lbl, text_halign=text.align_right)
    table.cell(dash, 0, 8, "Short " + sBar, text_color=shortScore >= 5 ? cre : shortScore >= 3 ? cyl : cg, text_size=lbl)
    table.cell(dash, 1, 8, sFrac,           text_color=shortScore >= minScore ? cre : cg, text_size=lbl, text_halign=text.align_right)

    table.merge_cells(dash, 0, 9, 1, 9)
    factorHdr = usePivot ? "── 7 Factors ──" : "── 6 Factors ──"
    table.cell(dash, 0, 9, factorHdr, text_color=cyl, text_size=lbl, text_halign=text.align_center)

    maLbl  = maType + "(" + str.tostring(maFastL) + "/" + str.tostring(maSlowL) + ")"
    fNames = array.from(maLbl, "Supertrend", momType, "Volume", "VWAP Side", "RSI-14 Bias", "Peak/Valley")
    fVals  = array.from(maFast > maSlow ? "▲ Bull" : "▼ Bear", stBull ? "▲ Bull" : "▼ Bear",
                        momLineLbl, volOK ? "✓ High" : "✗ Low",
                        aboveVWAP ? "▲ Above" : "▼ Below",
                        str.tostring(rsi14Val, "#.1") + (rsi14Bull ? " ▲" : " ▼"),
                        pivotLongFactor == 1 ? "▽ Valley" : pivotShortFactor == 1 ? "△ Peak" : "—")
    fOK    = array.from(maFast > maSlow ? 1 : 0, stBull ? 1 : 0,
                        momCrossUp ? 1 : momCrossDown ? -1 : 0,
                        volOK ? 1 : 0, aboveVWAP ? 1 : 0, rsi14Bull ? 1 : 0,
                        usePivot ? (pivotLongFactor == 1 or pivotShortFactor == 1 ? 1 : 0) : -2)

    showRows = usePivot ? 6 : 5
    for fi = 0 to showRows
        rawOK = array.get(fOK, fi)
        fc    = rawOK == 1 ? cgr : rawOK == -1 ? cre : rawOK == -2 ? cg : cg
        table.cell(dash, 0, 10 + fi, array.get(fNames, fi), text_color=rawOK == -2 ? color.new(cg, 50) : cg, text_size=lbl)
        table.cell(dash, 1, 10 + fi, array.get(fVals,  fi), text_color=fc, text_size=lbl, text_halign=text.align_right)

    fBase = usePivot ? 17 : 16

    table.merge_cells(dash, 0, fBase, 1, fBase)
    table.cell(dash, 0, fBase, "── Filters ──", text_color=cyl, text_size=lbl, text_halign=text.align_center)

    adxClr  = not useADX ? cg : adxOK ? cgr : cre
    adxStat = not useADX ? "OFF" : adxOK ? "✓ " + str.tostring(adxVal, "#.1") : "✗ " + str.tostring(adxVal, "#.1")
    table.cell(dash, 0, fBase + 1, "ADX ≥ " + str.tostring(adxMin, "#"), text_color=cg, text_size=lbl)
    table.cell(dash, 1, fBase + 1, adxStat, text_color=adxClr, text_size=lbl, text_halign=text.align_right)

    biasClr  = not useDailyBias ? cg : close > dailyEma200 ? cgr : cre
    biasStat = not useDailyBias ? "OFF" : close > dailyEma200 ? "▲ Bull (L only)" : "▼ Bear (S only)"
    table.cell(dash, 0, fBase + 2, "Daily EMA" + str.tostring(dailyEmaLen), text_color=cg, text_size=lbl)
    table.cell(dash, 1, fBase + 2, biasStat, text_color=biasClr, text_size=lbl, text_halign=text.align_right)

    mtfClr  = not useMTF ? cg : mtfBull ? cgr : cre
    mtfStat = not useMTF ? "OFF" : mtfBull ? "▲ Bull" : "▼ Bear"
    table.cell(dash, 0, fBase + 3, "MTF(" + mtfTF + ") ST", text_color=cg, text_size=lbl)
    table.cell(dash, 1, fBase + 3, mtfStat, text_color=mtfClr, text_size=lbl, text_halign=text.align_right)

    atrRatio  = atrAvg > 0 ? atr / atrAvg : 1.0
    spikeClr  = not useAtrSpike ? cg : atrSpikeOK ? cgr : cre
    spikeStat = not useAtrSpike ? "OFF" : atrSpikeOK ? "✓ " + str.tostring(atrRatio, "#.2") + "×" : "✗ " + str.tostring(atrRatio, "#.2") + "× SPIKE"
    table.cell(dash, 0, fBase + 4, "ATR Spike ×" + str.tostring(atrSpikeMult, "#.1"), text_color=cg, text_size=lbl)
    table.cell(dash, 1, fBase + 4, spikeStat, text_color=spikeClr, text_size=lbl, text_halign=text.align_right)

    cbClr  = not useCircuitBreaker ? cg : not cbBlocked ? cgr : cre
    cbStat = not useCircuitBreaker ? "OFF" : cbBlocked ? "⛔ PAUSED (" + str.tostring(consecLoss) + ")" : "✓ " + str.tostring(consecLoss) + "/" + str.tostring(maxConsecLoss)
    table.cell(dash, 0, fBase + 5, "Circuit Breaker", text_color=cg, text_size=lbl)
    table.cell(dash, 1, fBase + 5, cbStat, text_color=cbClr, text_size=lbl, text_halign=text.align_right)

    rangeClr  = not useRange ? cg : inRange ? cgr : cre
    rangeStat = not useRange ? "OFF" : inRange ? "✓ In Range" : "✗ Out of Range"
    table.cell(dash, 0, fBase + 6, "Backtest Range", text_color=cg, text_size=lbl)
    table.cell(dash, 1, fBase + 6, rangeStat, text_color=rangeClr, text_size=lbl, text_halign=text.align_right)

    table.merge_cells(dash, 0, fBase + 7, 1, fBase + 7)
    table.cell(dash, 0, fBase + 7, "── TP Levels ──", text_color=cyl, text_size=lbl, text_halign=text.align_center)

    tp1Stat = useTP1 ? str.tostring(tp1Mult, "#.1") + "× ATR / " + str.tostring(tp1Pct, "#") + "%" : "OFF"
    tp2Stat = useTP2 ? str.tostring(tp2Mult, "#.1") + "× ATR / " + str.tostring(tp2Pct, "#") + "%" : "OFF"
    tp3Stat = useTP3 ? str.tostring(tp3Mult, "#.1") + "× ATR / " + str.tostring(tp3Pct, "#") + "%" : "OFF"
    tp4Stat = useTP4 ? str.tostring(tp4Mult, "#.1") + "× ATR / " + str.tostring(tp4Pct, "#") + "%" : "OFF"
    table.cell(dash, 0, fBase +  8, "TP1", text_color=cg, text_size=lbl)
    table.cell(dash, 1, fBase +  8, tp1Stat, text_color=useTP1 ? cgr : cg, text_size=lbl, text_halign=text.align_right)
    table.cell(dash, 0, fBase +  9, "TP2", text_color=cg, text_size=lbl)
    table.cell(dash, 1, fBase +  9, tp2Stat, text_color=useTP2 ? cgr : cg, text_size=lbl, text_halign=text.align_right)
    table.cell(dash, 0, fBase + 10, "TP3", text_color=cg, text_size=lbl)
    table.cell(dash, 1, fBase + 10, tp3Stat, text_color=useTP3 ? cgr : cg, text_size=lbl, text_halign=text.align_right)
    table.cell(dash, 0, fBase + 11, "TP4", text_color=cg, text_size=lbl)
    table.cell(dash, 1, fBase + 11, tp4Stat, text_color=useTP4 ? cgr : cg, text_size=lbl, text_halign=text.align_right)

    dispScore = longScore >= shortScore ? longScore : shortScore
    topS      = usePivot ? 7 : 6
    scoreT    = topS > minScore ? math.max(0.0, math.min(1.0, (float(dispScore) - float(minScore)) / float(topS - minScore))) : 0.0
    scoreMult = useScoreSize and topS > minScore ? scoreMultMin + (scoreMultMax - scoreMultMin) * scoreT : 1.0
    sizeClr   = not useScoreSize ? cg : scoreMult >= 1.0 ? cgr : cyl
    sizeStat  = not useScoreSize ? "OFF" : str.tostring(scoreMult, "#.2") + "× (" + str.tostring(dispScore) + "pt)"
    table.cell(dash, 0, fBase + 12, "Score Sizing", text_color=cg, text_size=lbl)
    table.cell(dash, 1, fBase + 12, sizeStat, text_color=sizeClr, text_size=lbl, text_halign=text.align_right)

    table.merge_cells(dash, 0, fBase + 13, 1, fBase + 13)
    modeStr = maType + " | " + momType + (usePivot ? " | P/V" : "")
    table.cell(dash, 0, fBase + 13, modeStr, text_color=cyl, text_size=lbl, text_halign=text.align_center)

// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════
px = str.tostring(close, format.mintick)
tf = timeframe.period
if longCond
    la1  = useTP1 ? "TP1: " + str.tostring(close + atr * tp1Mult, format.mintick) + "\n" : ""
    la2  = useTP2 ? "TP2: " + str.tostring(close + atr * tp2Mult, format.mintick) + "\n" : ""
    la3  = useTP3 ? "TP3: " + str.tostring(close + atr * tp3Mult, format.mintick) + "\n" : ""
    la4  = useTP4 ? "TP4: " + str.tostring(close + atr * tp4Mult, format.mintick) : ""
    lMsg = "⚡ APEX LONG [" + str.tostring(longScore) + "/" + maxScoStr + "]\n" + syminfo.ticker + " · " + tf + "\n진입: " + px + "\nSL:  " + str.tostring(close - atr * slMult, format.mintick) + "\n" + la1 + la2 + la3 + la4
    alert(lMsg, alert.freq_once_per_bar_close)
if shortCond
    sa1  = useTP1 ? "TP1: " + str.tostring(close - atr * tp1Mult, format.mintick) + "\n" : ""
    sa2  = useTP2 ? "TP2: " + str.tostring(close - atr * tp2Mult, format.mintick) + "\n" : ""
    sa3  = useTP3 ? "TP3: " + str.tostring(close - atr * tp3Mult, format.mintick) + "\n" : ""
    sa4  = useTP4 ? "TP4: " + str.tostring(close - atr * tp4Mult, format.mintick) : ""
    sMsg = "⚡ APEX SHORT [" + str.tostring(shortScore) + "/" + maxScoStr + "]\n" + syminfo.ticker + " · " + tf + "\n진입: " + px + "\nSL:  " + str.tostring(close + atr * slMult, format.mintick) + "\n" + sa1 + sa2 + sa3 + sa4
    alert(sMsg, alert.freq_once_per_bar_close)
